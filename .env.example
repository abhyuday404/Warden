# Warden does not automatically load this file. Copy only the values you need
# into your shell, CI secret store, or process manager. Never commit .env.

# Required for plain-English requests in interactive `ward` and for `ward agent`.
OPENAI_API_KEY=

# Optional OpenAI agent overrides.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional path-list of Warden provider plugin manifests or directories.
# Windows example: C:\warden\providers;D:\company\warden-providers
WARD_PROVIDER_PLUGINS=

# Optional Prava identity directory. Leave unset to use Prava's default.
# Keep this directory private; it contains the linked agent identity.
PRAVA_STATE_DIR=

# Required only for the built-in Render deploy-hook adapter.
# Treat this URL as a secret.
RENDER_DEPLOY_HOOK=

# Optional provider-native non-interactive authentication. Interactive native
# login is preferred on developer workstations; use these mainly in CI.
FLY_API_TOKEN=
VERCEL_TOKEN=
